<resources>
    <style name="Theme.SEngine" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">#FF151619</item>
        <item name="android:navigationBarColor">#FF151619</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SEngine.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>

    <style name="SEngine.Panel">
        <item name="android:background">@color/panel</item>
    </style>
</resources>
